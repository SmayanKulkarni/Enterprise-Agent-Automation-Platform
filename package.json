{
  "name": "enterprise-agent-automation-platform",
  "version": "0.0.0",
  "private": true,
  "main": "dist/azure-functions/src/functions/*.js",
  "description": "Workspace foundation for the Enterprise Agent Automation Platform.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "workspace:check": "node tools/workspace/check-workspace.mjs",
    "contracts": "tsc -p packages/contracts/tsconfig.build.json && node tools/contracts/governance.mjs",
    "verify": "node tools/workspace/verify.mjs",
    "build:showcase": "corepack pnpm --dir apps/browser --ignore-workspace build",
    "build:azure": "tsc -p tsconfig.azure.json",
    "sql:migrate": "node tools/sql/azure-sql.mjs migrate",
    "sql:verify": "node tools/sql/azure-sql.mjs verify",
    "sql:status": "node tools/sql/azure-sql.mjs status",
    "sql:seed:demo": "node tools/sql/azure-sql.mjs seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "24.3.1",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@clerk/backend": "^3.17.2",
    "mssql": "^12.7.2"
  }
}
