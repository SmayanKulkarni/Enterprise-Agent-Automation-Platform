{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "target": "ES2024",
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "eslint.config.mjs", "tools/**/*.mjs", "tests/**/*.mjs", "tests/**/*.ts", "packages/**/*.ts"]
}
