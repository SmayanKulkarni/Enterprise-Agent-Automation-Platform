{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "azure-functions/**/*.ts", "packages/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/dist/**"]
}
